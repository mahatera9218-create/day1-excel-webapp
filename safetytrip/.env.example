# PostGIS (없으면 인메모리 fallback 사용)
# DATABASE_URL=postgres://user:pass@localhost:5432/safetytrip

# Google Maps — Street View (상세 화면의 "실제 거리 모습")
# GOOGLE_MAPS_API_KEY: 서버 전용. 촬영일 메타데이터 조회(무료, 쿼리 비용 0).
#   Street View Image Metadata API 활성화 필요.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY: iframe URL에 노출. HTTP 리퍼러 제한 권장.
#   Maps Embed API 활성화 필요(무료·무제한).
# 둘 다 같은 키를 써도 되지만, 노출되는 EMBED 키는 리퍼러 제한을 거는 것을 권장.
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# FR-02 지오코딩 기능 플래그 (공급자 계약 후 on)
# FEATURE_GEOCODING=on
